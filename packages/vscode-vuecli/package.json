{
  "name": "vscode-vuecli",
  "displayName": "vuecli",
  "description": "Live terminal-frame preview and App Router scaffolding for vuecli apps",
  "version": "0.1.0",
  "publisher": "vuecli",
  "license": "GPL-3.0-only",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other", "Visualization"],
  "keywords": ["vue", "terminal", "tui", "vuecli", "preview"],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/node_modules/vuecli/package.json",
    "workspaceContains:app/page.vue",
    "workspaceContains:src/app/page.vue"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "node build.mjs --production && npx @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      { "command": "vuecli.preview", "title": "Open Terminal Preview", "category": "vuecli", "icon": "$(open-preview)" },
      { "command": "vuecli.restartPreview", "title": "Restart Terminal Preview", "category": "vuecli" },
      { "command": "vuecli.newPage", "title": "New Page", "category": "vuecli" },
      { "command": "vuecli.newLayout", "title": "New Layout", "category": "vuecli" },
      { "command": "vuecli.newRouteHandler", "title": "New Route Handler", "category": "vuecli" }
    ],
    "keybindings": [
      {
        "command": "vuecli.preview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && editorLangId != markdown && resourceExtname =~ /^\\.(vue|ts|js|mts|mjs|tsx|jsx)$/"
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "vuecli.preview", "when": "resourceExtname == .vue", "group": "navigation" }
      ],
      "explorer/context": [
        { "command": "vuecli.newPage", "when": "explorerResourceIsFolder", "group": "vuecli@1" },
        { "command": "vuecli.newLayout", "when": "explorerResourceIsFolder", "group": "vuecli@2" },
        { "command": "vuecli.newRouteHandler", "when": "explorerResourceIsFolder", "group": "vuecli@3" },
        { "command": "vuecli.preview", "when": "resourceExtname == .vue", "group": "vuecli@0" }
      ]
    },
    "configuration": {
      "title": "vuecli",
      "properties": {
        "vuecli.cliPath": { "type": "string", "default": "", "description": "Path to vuecli's bin/vuecli.js. Default: node_modules/vuecli of the project." },
        "vuecli.nodePath": { "type": "string", "default": "node", "description": "Node.js executable used to run the preview." },
        "vuecli.preview.columns": { "type": "number", "default": 80, "description": "Initial preview width in cells." },
        "vuecli.preview.rows": { "type": "number", "default": 24, "description": "Initial preview height in cells." },
        "vuecli.preview.autoFit": { "type": "boolean", "default": true, "description": "Resize the virtual terminal to fit the preview panel." },
        "vuecli.preview.reloadOnSave": { "type": "boolean", "default": true, "description": "Restart the preview when a project file is saved." },
        "vuecli.preview.theme": { "type": "string", "default": "", "enum": ["", "dark", "light", "dracula"], "description": "Theme for the previewed app." }
      }
    }
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/vscode": "^1.145.0"
  }
}
